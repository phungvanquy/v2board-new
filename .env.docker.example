# Docker environment — copy to .env and edit secrets before `docker compose up`
# See also .env.example for inline documentation.

APP_NAME=V2Board
# Must stay `local`: config/horizon.php defines supervisors only under
# `environments.local`. With APP_ENV=production Horizon starts with no
# supervisors and queued jobs are never processed.
APP_ENV=local
APP_DEBUG=false
# Public URL of the site (used for callbacks, emails, subscription links)
APP_URL=http://localhost:8080
# Generate with: docker compose exec app php artisan key:generate --show
# Leave empty on first boot — entrypoint will generate one and persist it to .env
APP_KEY=

# PHP version for the app image (must satisfy composer platform — 8.4 if vendor was built on it)
PHP_VERSION=8.2

# --- Image source (optional) ---
# By default compose builds/uses local images (v2board-app:local /
# v2board-nginx:local). To deploy published releases with `pull` only, pin the
# registry tags (see docs/docker.md "Registry images"):
#APP_IMAGE=ghcr.io/<owner>/v2board-app:v1.2.3
#NGINX_IMAGE=ghcr.io/<owner>/v2board-nginx:v1.2.3

# Automatic schema update (v2board:update) on every app container boot.
# Default is on; set to 0 to migrate manually instead.
#V2BOARD_AUTO_UPDATE=0

# Host port mapped to nginx:80 (change if 8080 is taken)
APP_PORT=8080

# --- Database (service: db) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=v2board
DB_USERNAME=v2board
DB_PASSWORD=change_me_db_password
# Root password for MySQL container (internal only)
DB_ROOT_PASSWORD=change_me_root_password

# --- Redis (service: redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# Laravel cache / queue / session — redis is required for Horizon
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

HORIZON_MAX_PROCESSES=128

# --- Database backup & restore ---
# Uncomment to override defaults (documented in docs/docker.md).
#DB_TRANSFER_MAX_UPLOAD_MB=512
#DB_TRANSFER_ASYNC_THRESHOLD_MB=20
#DB_TRANSFER_KEEP_EXPORTS=true
#DB_TRANSFER_EXPORT_RETENTION=5

# --- First-boot admin (optional) ---
# If set, entrypoint creates the initial admin account on first boot when
# the users table is empty. Leave empty to create the admin manually.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Mail (edit as needed) ---
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Optional services ---
LOG_CHANNEL=stack
BROADCAST_DRIVER=log
